# Ignore everything at repository root
/*

# Allow the usb_tester folder
!usb_tester/

# Ignore everything inside usb_tester
usb_tester/*

# Allow Python files at the root of usb_tester
!usb_tester/*.py

# Allow README and requirements
!usb_tester/README.md
!usb_tester/requirements.txt

# Allow the report template
!usb_tester/Report_Template.docx

# Keep .gitignore
!/.gitignore