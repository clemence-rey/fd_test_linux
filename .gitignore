# Ignorer tout à la racine
/*

# Autoriser le dossier usb_tester
!usb_tester/

# Ignorer son contenu
usb_tester/*

# Autoriser uniquement les fichiers Python à sa racine
!usb_tester/*.py

# Autoriser README et requirements
!usb_tester/README.md
!usb_tester/requirements.txt

# Conserver le .gitignore
!/.gitignore

# Autoriser le template de rapport
!/Pyhon/usb_tester/Report_Template.docx